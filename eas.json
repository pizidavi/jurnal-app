{
  "cli": {
    "version": "16",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "autoIncrement": false,
      "environment": "development",
      "env": {
        "NODE_ENV": "development",
        "EXPO_PUBLIC_ENVIRONMENT": "development"
      }
    },
    "preview": {
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_ENVIRONMENT": "preview"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_ENVIRONMENT": "production"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
