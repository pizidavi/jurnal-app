{
  "name": "jurnal",
  "version": "0.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "prebuild": "expo prebuild",
    "dev": "expo start -c -d",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:build": "eas build --profile development --platform android --local --clear-cache --non-interactive",
    "ios:build": "eas build --profile development --platform ios --local --clear-cache --non-interactive",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --no-error-on-unmatched-pattern --report-unused-disable-directives",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@docren/react-native-markdown": "^0.8.5",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "@tanstack/ai": "^0.5.0",
    "@tanstack/ai-openai": "^0.5.0",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.16.1",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-orm": "^0.45.2",
    "eventemitter3": "^5.0.4",
    "expo": "~54.0.35",
    "expo-build-properties": "~1.0.10",
    "expo-file-system": "~19.0.23",
    "expo-localization": "~17.0.9",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "i18next": "^25.8.4",
    "lucide-react-native": "^1.17.0",
    "react": "19.1.0",
    "react-i18next": "^16.5.4",
    "react-native": "0.81.5",
    "react-native-audio-api": "^0.11.4",
    "react-native-executorch": "^0.7.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-logs": "^5.6.0",
    "react-native-mmkv": "^4.1.2",
    "react-native-nitro-modules": "^0.33.7",
    "react-native-permissions": "^5.4.4",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "uniwind": "^1.7.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.39.2",
    "@types/react": "~19.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-drizzle-studio-plugin": "^0.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored --no-error-on-unmatched-pattern --report-unused-disable-directives"
    ],
    "*.{mjs,json,md,css}": [
      "prettier --write"
    ]
  }
}
